{
  "name": "@tdb-project/mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "stdio MCP server that forwards to a TDB server's Streamable HTTP endpoint",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node esbuild.mjs && tsc -p tsconfig.test.json",
    "test": "node --test --test-timeout=60000 \"out/test/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
